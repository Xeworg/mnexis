{
  "scenario": "two-processes-share-profile-with-optimistic-concurrency",
  "processes": [
    { "name": "agent-a", "scope": { "read_namespaces": ["project-a"], "write_namespaces": ["project-a"], "default_namespace": "project-a", "allow_global": false, "allowed_operations": ["memory_save", "memory_get", "memory_update", "memory_delete"] } },
    { "name": "agent-b", "scope": { "read_namespaces": ["project-a"], "write_namespaces": ["project-a"], "default_namespace": "project-a", "allow_global": false, "allowed_operations": ["memory_get", "memory_update"] } }
  ],
  "steps": [
    { "actor": "agent-a", "operation": "memory_save", "topic_key": "architecture.graph-engine", "idempotency_key": "save-1" },
    { "actor": "agent-b", "operation": "memory_get", "namespace": "project-a", "expected_revision": 1 },
    { "actor": "agent-a", "operation": "memory_update", "expected_revision": 1 },
    { "actor": "agent-b", "operation": "memory_update", "expected_revision": 1 },
    { "actor": "agent-a", "operation": "memory_delete", "expected_revision": 2 }
  ],
  "expect": {
    "both_processes_observe_committed_revision": true,
    "exactly_one_update_wins": true,
    "losing_update_has_no_partial_history_or_fts_write": true,
    "out_of_scope_namespace_is_not_disclosed": true,
    "delete_removes_memory_from_default_search_and_context": true,
    "delete_is_restorable_until_purge": true
  }
}
