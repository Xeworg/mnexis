{
  "scenario": "explicit-supersede-does-not-recommend-old-decision",
  "given": {
    "namespace": "project-a",
    "old": { "id": "11111111-1111-4111-8111-111111111111", "revision": 2, "state": "active", "content": "Use petgraph." },
    "new": { "id": "22222222-2222-4222-8222-222222222222", "revision": 1, "state": "proposed", "content": "Use a custom graph engine." }
  },
  "when": {
    "operation": "memory_supersede",
    "expected_old_revision": 2,
    "expected_new_revision": 1,
    "reason": "Replaced after performance evaluation."
  },
  "expect": {
    "atomic": true,
    "old_state": "superseded",
    "new_state": "active",
    "default_context_contains_old": false,
    "default_context_contains_new": true,
    "authorized_history_can_read_old_revision": true
  }
}
